{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "commitSHA", "port", "hostname"],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "^.+@sha256:[0-9a-f]{64}$",
      "description": "Complete image reference pinned by a sha256 digest."
    },
    "commitSHA": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Full source commit SHA reported by the preview."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "imagePullSecret": {
      "type": "string"
    },
    "configMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectSize"],
      "properties": {
        "projectSize": {"type": "string", "enum": ["simple"]}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "automount": {"type": "boolean"}
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiGroups": {"type": "array", "items": {"type": "string"}},
              "resources": {"type": "array", "items": {"type": "string"}},
              "verbs": {"type": "array", "items": {"type": "string"}},
              "resourceNames": {"type": "array", "items": {"type": "string"}}
            },
            "required": ["apiGroups", "resources", "verbs"]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resources"
        },
        "limits": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "hard": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1}
      }
    }
  }
}
